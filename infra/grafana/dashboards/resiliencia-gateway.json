  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Resiliencia del gateway\n**R02 y R18.** El gateway corta las ráfagas con **429 + `Retry-After`** antes de que lleguen a Billing. La meta de la Fase 3 es **cero 5xx** durante la saturación. Límites: 60 por minuto por `sub` (`user-by-sub`), 60 por IP sin token (`anon-by-ip`) y 5 por IP en `/connect/token`."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Aceptadas (2xx)",
      "description": "Respuestas 2xx del gateway en el rango.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"secunitec-gateway\",http_response_status_code=~\"2..\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2a78d6",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
