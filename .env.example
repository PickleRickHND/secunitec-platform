# Copiar a .env y sustituir cada valor CAMBIAR_* antes de iniciar Compose. Usar valores largos y aleatorios:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Identity y Billing no arrancan si un secreto conserva el prefijo CAMBIAR.
POSTGRES_ADMIN_PASSWORD=CAMBIAR_POSTGRES_ADMIN
BILLING_DB_PASSWORD=CAMBIAR_BILLING_DB
IDENTITY_DB_PASSWORD=CAMBIAR_IDENTITY_DB
MONGO_ADMIN_PASSWORD=CAMBIAR_MONGO_ADMIN
MONGO_BILLING_PASSWORD=CAMBIAR_MONGO_BILLING
MONGO_IDENTITY_PASSWORD=CAMBIAR_MONGO_IDENTITY
REDIS_PASSWORD=CAMBIAR_REDIS

# URL pública del gateway, sin barra final: es el issuer de los tokens y la que usan el navegador y JMeter.
SECUNITEC_PUBLIC_URL=https://localhost:8080
# URL pública del SPA, sin barra final: URIs de redirección de OIDC y único origen admitido por CORS (etapa 4.1).
# Usar localhost, no 127.0.0.1: el navegador trata a localhost como contexto seguro (PKCE) y CORS compara el texto.
# El SPA fija ambas URLs al construir su imagen: si cambian, levantar con --build.
SECUNITEC_SPA_URL=http://localhost:3000

# Solo para probar Billing sin Identity (etapa 2.2). Con Identity (etapa 3) dejarlo vacío.
# Si se usa: mínimo 32 bytes, solo en Development, y Billing no arranca con el prefijo CAMBIAR.
BILLING_TEST_JWT_KEY=

# Identity. Las contraseñas exigen 12 caracteres con mayúscula, minúscula, dígito y símbolo.
IDENTITY_REGISTRATION_TENANT_ID=00000000-0000-0000-0000-000000000001
IDENTITY_SEED_ADMIN_EMAIL=admin@secunitec.local
IDENTITY_SEED_ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD_LARGO
IDENTITY_SEED_ADMIN_TENANT_ID=00000000-0000-0000-0000-000000000001
IDENTITY_JMETER_CLIENT_SECRET=CAMBIAR_JMETER_CLIENT_SECRET_LARGO
IDENTITY_JMETER_TENANT_ID=00000000-0000-0000-0000-000000000001
# Opcional: si se define, se crean facturador@, auditor@ y cliente@secunitec.local con esta contraseña.
IDENTITY_SEED_DEMO_PASSWORD=
# Cliente de Billing asociado al usuario cliente@secunitec.local (Billing lo siembra en Development).
SEED_CLIENTE_ID=00000000-0000-0000-0000-0000000000c1

# Solo si Mongo se cierra con "Linux kernel versions 6.19 and newer..." (docs/problemas-conocidos.md).
# MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1
