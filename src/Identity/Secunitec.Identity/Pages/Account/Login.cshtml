@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<section class="card" aria-labelledby="titulo">
    <h1 id="titulo">Iniciar sesión</h1>
    <p class="lead">Use el correo y la contraseña de su cuenta de Secunitec.</p>
    @if (Model.Registered)
    {
        <p class="notice">Si la cuenta se pudo crear, ya puede iniciar sesión. Un administrador debe asignarle un rol antes de que pueda facturar o consultar.</p>
    }
    @if (Model.Error is not null)
    {
        <p class="alert" role="alert" id="error-login">@Model.Error</p>
    }
    <form method="post" class="form">
        <input type="hidden" asp-for="ReturnUrl">
        <div class="field">
            <label asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" autocomplete="username" required autofocus>
        </div>
        <div class="field">
            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="button">Iniciar sesión</button>
    </form>
    <p class="aside">¿Aún no tiene cuenta? <a asp-page="/Account/Register">Crear una cuenta</a></p>
</section>
<p class="footnote">Después de cinco intentos fallidos la cuenta se bloquea 15 minutos. Cada intento queda registrado en la auditoría.</p>
