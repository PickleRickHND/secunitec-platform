@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<h2>Iniciar sesión</h2>
@if (Model.Registered)
{
    <p>Si la cuenta se pudo crear, ya puede iniciar sesión.</p>
}
@if (Model.Error is not null)
{
    <p role="alert">@Model.Error</p>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl">
    <p><label>Correo <input asp-for="Email" type="email" autocomplete="username" required></label></p>
    <p><label>Contraseña <input asp-for="Password" type="password" autocomplete="current-password" required></label></p>
    <p><button type="submit">Entrar</button></p>
</form>
<p><a asp-page="/Account/Register">Crear una cuenta</a></p>
