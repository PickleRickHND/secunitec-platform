{
  "Jwt": {
    "Authority": "http://identity:8080"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-discovery": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "identity-connect": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      },
      "identity-account": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/account/{**catch-all}"
        }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "billing": {
        "Destinations": {
          "billing": {
            "Address": "http://billing:8080/"
          }
        }
      }
    }
  }
}