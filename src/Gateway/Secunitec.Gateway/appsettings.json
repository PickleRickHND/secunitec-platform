{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Jwt": {
    "Authority": "http://identity:8080"
  },
  "Redis": {
    "ConnectionString": "redis:6379,abortConnect=false"
  },
  "RateLimiting": {
    "TokenEndpointPermitLimit": 5,
    "AnonymousPermitLimit": 60,
    "UserPermitLimit": 60,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "identity-token": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "token-endpoint",
        "Match": { "Path": "/connect/token" },
        "Transforms": [
          { "ResponseHeaderRemove": "Server", "When": "Always" },
          { "ResponseHeaderRemove": "X-Powered-By", "When": "Always" }
        ]
      },
      "identity-connect": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anon-by-ip",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Transforms": [
          { "ResponseHeaderRemove": "Server", "When": "Always" },
          { "ResponseHeaderRemove": "X-Powered-By", "When": "Always" }
        ]
      },
      "identity-discovery": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anon-by-ip",
        "Match": { "Path": "/.well-known/{**catch-all}" },
        "Transforms": [
          { "ResponseHeaderRemove": "Server", "When": "Always" },
          { "ResponseHeaderRemove": "X-Powered-By", "When": "Always" }
        ]
      },
      "identity-account": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anon-by-ip",
        "Match": { "Path": "/account/{**catch-all}" },
        "Transforms": [
          { "ResponseHeaderRemove": "Server", "When": "Always" },
          { "ResponseHeaderRemove": "X-Powered-By", "When": "Always" }
        ]
      },
      "billing": {
        "ClusterId": "billing",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user-by-sub",
        "Match": { "Path": "/api/billing/{**catch-all}" },
        "Transforms": [
          { "ResponseHeaderRemove": "Server", "When": "Always" },
          { "ResponseHeaderRemove": "X-Powered-By", "When": "Always" }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "identity": { "Address": "http://identity:8080/" }
        }
      },
      "billing": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "billing": { "Address": "http://billing:8080/" }
        }
      }
    }
  }
}
